---
// Decorative call card for the AI voice agent section. Waveform respects reduced motion.
const bars = Array.from({ length: 22 }, (_, i) => ({ h: 10 + ((i * 29) % 30), d: 0.7 + (i % 4) * 0.15, delay: (i % 6) * 0.07 }));
const facts = [
  { k: 'Need', v: '20,000 boxes / month' },
  { k: 'Timeline', v: 'Next month' },
  { k: 'Status', v: 'Qualified', good: true },
  { k: 'Meeting', v: 'Thu, 11:00' },
];
---

<figure class="flex flex-col gap-[18px] rounded-[18px] border border-[#252935] bg-[#15181F] p-6">
  <figcaption class="sr-only">Example AI voice agent call qualifying a lead</figcaption>
  <div class="flex items-center justify-between">
    <span class="flex flex-col gap-0.5"><strong class="text-base font-semibold">Rohit Mehta</strong><span class="text-[13px] text-[#8C91A0]">Website enquiry · Delhi</span></span>
    <span class="font-mono text-xs text-[#FB923C]">● 02:14 · Hindi</span>
  </div>
  <div aria-hidden="true" class="flex h-12 items-center justify-center gap-[3px]">
    {bars.map((b) => (
      <span class="block w-[3px] animate-[wave_var(--d)_ease-in-out_var(--delay)_infinite] rounded-sm bg-[#C2410C]" style={`height:${b.h}px;--d:${b.d}s;--delay:${b.delay}s`}></span>
    ))}
  </div>
  <dl class="grid grid-cols-2 gap-2">
    {facts.map((f) => (
      <div class="flex flex-col-reverse rounded-[10px] bg-[#1C2029] p-3">
        <dd class:list={['text-sm font-medium', f.good && 'text-[#4ADE80]']}>{f.v}</dd>
        <dt class="text-xs text-[#8C91A0]">{f.k}</dt>
      </div>
    ))}
  </dl>
</figure>
