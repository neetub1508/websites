---
// Decorative preview of the planned AI voice agent (not yet available). Waveform respects reduced motion.
const bars = Array.from({ length: 22 }, (_, i) => ({ h: 10 + ((i * 29) % 30), d: 0.7 + (i % 4) * 0.15, delay: (i % 6) * 0.07 }));
const facts = [
  { k: 'Need', v: '20,000 boxes / month' },
  { k: 'Timeline', v: 'Next month' },
  { k: 'Status', v: 'Qualified', good: true },
  { k: 'Meeting', v: 'Thu, 11:00' },
];
---

<figure class="flex flex-col gap-[18px] rounded-[18px] border border-[#252935] bg-[#15181F] p-6">
  <div class="rounded-xl bg-[#FCFAF4]">
    <img src="/images/features/voice-ai-coming-soon.webp" srcset="/images/features/voice-ai-coming-soon-640.webp 640w, /images/features/voice-ai-coming-soon.webp 1200w" sizes="(min-width:445px) 347px, calc(100vw - 98px)" alt="Concept illustration of a voice waveform, phone and contact cards; the AI voice agent is coming soon." width="1200" height="900" loading="lazy" decoding="async" class="mx-auto block aspect-[4/3] h-auto w-full max-w-[347px] object-contain" />
  </div>
  <figcaption class="sr-only">Design preview of a planned AI voice agent call qualifying a lead</figcaption>
  <div class="flex items-center justify-between">
    <span class="flex flex-col gap-0.5"><strong class="text-base font-semibold">Rohit Mehta</strong><span class="text-[13px] text-[#8C91A0]">Website enquiry · Delhi</span></span>
    <span class="rounded-full bg-[#252935] px-2.5 py-0.5 text-[11px] text-[#B9BDC9]">Design preview</span>
  </div>
  <div aria-hidden="true" class="flex h-12 items-center justify-center gap-[3px]">
    {bars.map((b) => (
      <span class="block w-[3px] animate-[wave_var(--d)_ease-in-out_var(--delay)_infinite] rounded-sm bg-[#C2410C]" style={`height:${b.h}px;--d:${b.d}s;--delay:${b.delay}s`}></span>
    ))}
  </div>
  <dl class="grid grid-cols-2 gap-2">
    {facts.map((f) => (
      <div class="flex flex-col-reverse rounded-[10px] bg-[#1C2029] p-3">
        <dd class:list={['text-sm font-medium', f.good && 'text-[#4ADE80]']}>{f.v}</dd>
        <dt class="text-xs text-[#8C91A0]">{f.k}</dt>
      </div>
    ))}
  </dl>
</figure>
