---
// Visible breadcrumb trail. Pair with breadcrumbs() schema using the same items.
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="container-page pt-8">
  <ol class="flex flex-wrap items-center gap-2 text-[13px] text-ink-400">
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        {i < items.length - 1 ? (
          <><a href={it.path} class="hover:text-brand">{it.name}</a><span aria-hidden="true">/</span></>
        ) : (
          <span aria-current="page" class="text-ink-700">{it.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
