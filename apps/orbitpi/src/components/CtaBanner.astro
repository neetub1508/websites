---
interface Props { title?: string; text?: string; cta?: string; href?: string }
const {
  title = 'See OrbitPi on your own data',
  text = 'Bring a sample invoice, stock sheet or lead list. We’ll run it live in a 30-minute demo.',
  cta = 'Book a demo',
  href = '/contact/',
} = Astro.props;
---

<section aria-labelledby="cta-title" class="px-6 pb-24">
  <div class="mx-auto flex max-w-[1240px] flex-col items-start gap-5 rounded-[18px] border border-[#DFE5FC] bg-[#F2F5FF] px-[clamp(28px,5vw,56px)] py-[clamp(36px,5vw,56px)] text-ink">
    <h2 id="cta-title" class="h-section max-w-2xl">{title}</h2>
    <p class="max-w-md text-[17px] leading-relaxed text-ink-500">{text}</p>
    <a href={href} class="btn-primary">{cta}</a>
  </div>
</section>
