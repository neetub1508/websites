---
interface Props { title?: string; text?: string; cta?: string; href?: string; secondaryHref?: string; secondaryLabel?: string }
const {
  title = 'See OrbitPi on your own data',
  text = 'Bring a sample invoice, stock sheet or lead list. We’ll run it live in a 30-minute demo.',
  cta = 'Book a demo',
  href = '/contact/',
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section aria-labelledby="cta-title" class="container-page section-space-bottom">
  <div class="cta-panel">
    <div class="min-w-0">
      <p class="section-eyebrow">LET’S TALK ABOUT YOUR OPERATIONS</p>
      <h2 id="cta-title" class="h-section max-w-2xl">{title}</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-500">{text}</p>
    </div>
    <div class="flex flex-none flex-col items-start gap-5 lg:items-center">
      <a href={href} class="btn-primary">{cta} <span aria-hidden="true">↗</span></a>
      {secondaryHref && secondaryLabel && <a href={secondaryHref} class="text-base font-semibold hover:text-brand">{secondaryLabel} <span aria-hidden="true">→</span></a>}
    </div>
  </div>
</section>

<style>
  .cta-panel { display: flex; justify-content: space-between; align-items: center; gap: 40px; padding: 56px; background: #f2f5ff; border: 1px solid #dfe5fc; border-radius: 18px; }
  @media (max-width: 899px) { .cta-panel { align-items: flex-start; flex-direction: column; padding: 36px; } }
  @media (max-width: 599px) { .cta-panel { padding: 28px; } }
</style>
