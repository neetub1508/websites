---
// Accessible FAQ using native <details>. Pair with faqPage() schema on the page
// so the visible text and structured data always match.
import SectionHeading from '@/components/SectionHeading.astro';
import type { Faq } from '@/lib/products';
interface Props { faqs: Faq[]; title?: string; id?: string }
const { faqs, title = 'Frequently asked questions', id = 'faq' } = Astro.props;
---

<section aria-labelledby={id} class="container-page section-space faq-layout">
  <div class="faq-heading">
    <p class="section-eyebrow">QUESTIONS, ANSWERED</p>
    <SectionHeading title={title} id={id} />
    <a href="/contact/" class="mt-6 inline-flex items-center gap-2 text-base font-semibold text-brand hover:underline">Talk to our team <span aria-hidden="true">→</span></a>
  </div>
  <div class="flex min-w-0 flex-col gap-3">
    {faqs.map((f, i) => (
      <details class="group rounded-[14px] border border-line-strong bg-white open:border-brand-light" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 [&::-webkit-details-marker]:hidden">
          <h3 class="text-lg font-semibold leading-relaxed">{f.q}</h3>
          <span aria-hidden="true" class="grid size-7 flex-none place-items-center rounded-full bg-mist text-lg text-ink-700 transition group-open:rotate-45">+</span>
        </summary>
        <p class="px-6 pb-6 text-base leading-relaxed text-ink-500">{f.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-layout { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.5fr); gap: 64px; }
  .faq-heading { min-width: 0; }
  @media (max-width: 899px) { .faq-layout { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
</style>
