---
// Latin subsets only: the site is English (₹ is in latin-ext). The full Fontsource stylesheets
// declare Cyrillic and Vietnamese faces too, which roughly doubled the render-blocking CSS.
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistLatinExt from '@fontsource-variable/geist/files/geist-latin-ext-wght-normal.woff2?url';
import { SITE, absoluteUrl } from '@/lib/site';
import type { JsonLd } from '@/lib/schema';

export interface SocialImage { src: string; alt: string; width: number; height: number }

interface Props {
  title: string;
  description: string;
  schema?: JsonLd;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  image?: SocialImage; // page-specific share image; defaults to the site-wide one
  published?: string; // ISO dates for article pages
  modified?: string;
}

const { title, description, schema, ogType = 'website', noindex = false, image, published, modified } = Astro.props;
// Noindex pages (404, thank-you) get no canonical: they have no indexable URL to point to.
const canonical = noindex ? undefined : absoluteUrl(Astro.url.pathname);
const social: SocialImage = image ?? {
  src: SITE.ogImage,
  alt: 'OrbitPi: AI for your back office. Documents, stock, leads and assets. Accounting and Voice AI coming soon.',
  width: 1200,
  height: 630,
};
const ogImage = absoluteUrl(social.src);
// Same descriptors as @fontsource-variable/geist/wght.css for its latin and latin-ext faces.
const geistFaces = [
  [geistLatinExt, 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF'],
  [geistLatin, 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'],
].map(([url, range]) => `@font-face{font-family:'Geist Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${url}) format('woff2-variations');unicode-range:${range}}`).join('');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- Preloaded so hero text renders in Geist without a late font swap. -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={geistFaces} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(social.width)} />
    <meta property="og:image:height" content={String(social.height)} />
    <meta property="og:image:alt" content={social.alt} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={social.alt} />

    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
