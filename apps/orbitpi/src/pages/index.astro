---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductCard from '@/components/ProductCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import ProductDemo from '@/components/home/ProductDemo.astro';
import IndustryExplorer from '@/components/home/IndustryExplorer.astro';
import VoiceCallCard from '@/components/home/VoiceCallCard.astro';
import { PRODUCTS, productHref, isAvailable } from '@/lib/products';
import { SITE, absoluteUrl } from '@/lib/site';
import { graph, webPage, faqPage, itemList, type JsonLd } from '@/lib/schema';

const LIVE = PRODUCTS.filter(isAvailable);
const title = 'OrbitPi | AI Document OCR, Inventory, Lead & Asset Software';
const description = SITE.description;

const steps = [
  { title: 'Capture', body: 'Invoices arrive by email, goods by GRN and enquiries by web form, each with its source.' },
  { title: 'Check', body: 'AI reads documents, scans confirm stock and rules route every lead.' },
  { title: 'Review exceptions', body: 'People handle only what needs a decision, from clear queues.' },
  { title: 'Report', body: 'Dashboards and exports show what happened and what is due next.' },
];

const faqs = [
  { q: 'What is OrbitPi?', a: 'OrbitPi is AI business software for Indian businesses. Four products are available today: DocAI for AI document OCR, Stock for warehouse inventory management, Leads for lead management and Assets for asset management. Ledger, for accounting, is in development.' },
  { q: 'Can I buy just one OrbitPi product?', a: 'Yes. Each product works on its own, and you can add more later on the same platform, with the same users, branches and roles.' },
  { q: 'Is OrbitPi built for Indian businesses?', a: 'Yes. OrbitPi handles GSTINs, HSN codes, e-way bills, delivery challans, GST e-invoice QR codes, CARO asset verification and rupee valuation, and DocAI, Stock and Leads screens are available in English and Hindi.' },
  { q: 'Does OrbitPi have mobile apps?', a: 'Not yet. OrbitPi runs in the web browser. Asset QR codes open in any phone browser, so staff can identify an asset or report a problem without installing an app.' },
  { q: 'Does OrbitPi have an AI voice agent?', a: 'An AI voice agent that calls and qualifies leads in Hindi and English is in development. OrbitPi Leads already captures, routes and tracks follow-up of every enquiry.' },
  { q: 'Is OrbitPi accounting software available?', a: 'Not yet. OrbitPi Ledger is in development. DocAI can export invoice data to Excel, CSV, webhooks and other destinations for the accounting software you use today.' },
];

const software: JsonLd = {
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
  publisher: { '@id': `${SITE.url}/#org` },
};

const schema = graph(
  webPage(absoluteUrl('/'), title, description),
  software,
  itemList('OrbitPi products', LIVE.map((p) => ({ name: p.fullName, path: productHref(p.slug) }))),
  faqPage(faqs),
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <section aria-labelledby="hero-title" class="relative overflow-hidden bg-[radial-gradient(60%_50%_at_50%_0%,#EEF1FF_0%,rgba(255,255,255,0)_70%)]">
    <div class="container-page flex flex-col items-center gap-6 pb-24 pt-20 text-center md:pt-24">
      <a href="/products/" class="flex items-center gap-2.5 rounded-full border border-[#E1E4F5] bg-white py-1.5 pl-3.5 pr-1.5 text-[13px] text-ink-700 hover:border-brand hover:text-ink">
        <span>Four products live · Accounting coming soon</span>
        <span class="rounded-full bg-brand-soft px-2.5 py-0.5 font-medium text-brand">See products →</span>
      </a>
      <h1 id="hero-title" class="h-display max-w-4xl">AI software that runs your back office</h1>
      <p class="lead max-w-2xl">AI document OCR, warehouse inventory, lead management and asset management software for Indian businesses. Use one product or several on one platform.</p>
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <a href="/contact/" class="btn-primary">Book a demo</a>
        <a href="#products" class="btn-ghost">Explore products</a>
      </div>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-[13px] text-ink-500">
        <li>✓ Works alone or as a suite</li><li>✓ GSTIN, e-way bill and e-invoice QR support</li><li>✓ Runs in your browser</li>
      </ul>
      <ProductDemo />
    </div>
  </section>

  <section id="products" aria-labelledby="products-title" class="container-page flex flex-col gap-12 py-24">
    <SectionHeading eyebrow="Products" id="products-title" title="Four products today. One more on the way." lead="Each product solves one job well and runs on the same OrbitPi platform, with shared users, branches and roles." />
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {PRODUCTS.map((p) => <ProductCard product={p} showImage />)}
      <a href="/contact/" class="flex flex-col justify-between gap-6 rounded-[18px] bg-ink bg-[radial-gradient(80%_60%_at_100%_0%,rgba(47,75,255,0.45),rgba(47,75,255,0))] p-7 text-white hover:text-white">
        <span class="flex flex-col gap-2.5"><span class="text-2xl font-semibold leading-tight tracking-[-0.03em]">Run several as one suite</span><span class="text-[15px] leading-normal text-[#B9BDC9]">One platform, shared users and branches, bundle pricing.</span></span>
        <span class="self-start rounded-[10px] bg-white px-[18px] py-[11px] text-sm font-medium text-ink">Book a suite demo</span>
      </a>
    </div>
  </section>

  <section aria-labelledby="voice-title" class="bg-ink text-white">
    <div class="container-page grid items-center gap-14 py-24 md:grid-cols-2">
      <div class="flex flex-col gap-[18px]">
        <SectionHeading eyebrow="Coming soon: AI voice agent" id="voice-title" title="An AI voice agent for every new lead" align="left" inverted lead="We are building an agent that calls new enquiries in Hindi and English, asks your qualifying questions and logs the answers in OrbitPi Leads. Until it launches, Leads routes every enquiry and reminds your team when to call." />
        <a href={productHref('lead-management-ai-voice-agent')} class="text-[15px] font-medium hover:text-brand-light">See OrbitPi Leads →</a>
      </div>
      <VoiceCallCard />
    </div>
  </section>

  <section aria-labelledby="how-title" class="container-page flex flex-col gap-12 py-24">
    <SectionHeading eyebrow="How it works" id="how-title" title="Less typing, fewer missed steps" />
    <figure class="overflow-hidden rounded-[20px] border border-line bg-[#FCFAF4]">
      <img src="/images/platform/capture-check-review-report.webp" srcset="/images/platform/capture-check-review-report-800.webp 800w, /images/platform/capture-check-review-report.webp 1600w" sizes="(min-width:1440px) 1390px, calc(100vw - 50px)" alt="Documents move through capture, checking, human review and structured reporting." width="1600" height="600" loading="lazy" decoding="async" class="block h-auto w-full" />
    </figure>
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <li class="flex flex-col gap-3 rounded-2xl border border-line p-6">
          <span class="grid size-8 place-items-center rounded-full bg-brand-soft text-sm font-semibold text-brand">{i + 1}</span>
          <h3 class="text-lg font-semibold tracking-[-0.02em]">{s.title}</h3>
          <p class="text-[15px] leading-normal text-ink-500">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="ind-title" class="border-y border-line bg-mist">
    <div class="container-page flex flex-col gap-10 py-24">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <SectionHeading eyebrow="Industries" id="ind-title" title="Built for your industry" align="left" />
        <p class="max-w-[420px] text-base leading-normal text-ink-500">Pick your industry to see which OrbitPi products fit and what they handle for you.</p>
      </div>
      <IndustryExplorer />
    </div>
  </section>

  <section aria-labelledby="price-title" class="container-page pb-6 pt-24">
    <div class="flex flex-wrap items-center justify-between gap-7 rounded-[20px] border border-line-strong p-[clamp(32px,5vw,56px)]">
      <div class="flex max-w-xl flex-col gap-3">
        <SectionHeading eyebrow="Pricing" id="price-title" title="Pay only for the products you use" align="left" lead="Start with one product. Add more anytime, with bundle pricing on the suite." />
      </div>
      <div class="flex flex-wrap gap-2.5">
        <a href="/pricing/" class="btn-dark">View pricing</a>
        <a href="/contact/" class="btn-ghost">Talk to sales</a>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} />
  <CtaBanner />
</BaseLayout>
