---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { PRODUCTS, isAvailable } from '@/lib/products';
import { SITE, absoluteUrl } from '@/lib/site';
import { graph, webPage, breadcrumbs } from '@/lib/schema';

const title = 'Contact OrbitPi | Book a Demo of Our AI Business Software';
const description = 'Book a demo of OrbitPi document OCR, warehouse inventory, lead or asset management software. Tell our team about your workflow and request product pricing.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }];
const schema = graph(webPage(absoluteUrl('/contact/'), title, description, 'ContactPage'), breadcrumbs(crumbs));
const input = 'w-full rounded-[10px] border border-line-strong bg-white px-3.5 py-3 text-base outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/20';
const mapQuery = encodeURIComponent(`${SITE.address.street}, ${SITE.address.city}`);
---

<BaseLayout title={title} description={description} schema={schema}>
  <Breadcrumbs items={crumbs} />
  <section class="container-page contact-layout" aria-labelledby="contact-title">
    <div class="contact-intro">
      <p class="section-eyebrow">LET’S TALK ABOUT YOUR OPERATIONS</p>
      <h1 id="contact-title" class="h-display">A clearer way<br />to run your day.</h1>
      <p class="lead">Stock, documents, leads or assets. Tell us where your team needs a better workflow, and let’s explore the right OrbitPi products.</p>
      <ol class="contact-steps">
        <li><span aria-hidden="true">01</span><div><h2>Start with your workflow</h2><p>Share your products, team size and the work you want to improve.</p></div></li>
        <li><span aria-hidden="true">02</span><div><h2>Explore the software</h2><p>Discuss the relevant modules and what you would like to see in a demo.</p></div></li>
        <li><span aria-hidden="true">03</span><div><h2>Discuss your next step</h2><p>Talk through scope, setup and pricing for your business.</p></div></li>
      </ol>
      <div class="contact-direct"><p>Prefer email?</p><a href={`mailto:${SITE.salesEmail}`}>{SITE.salesEmail} <span aria-hidden="true">↗</span></a><span>{SITE.hours}</span></div>
    </div>

    <form data-contact method="post" action="/api/contact" class="contact-form" novalidate>
      <div class="form-heading"><p class="section-eyebrow">BOOK A PRODUCT DEMO</p><h2>Tell us about your team</h2><p>Name, work email and company are required.</p></div>
      <div class="grid gap-x-5 gap-y-5 sm:grid-cols-2">
        <label class="contact-field"><span>Full name <span class="text-brand" aria-hidden="true">*</span></span><input name="name" required autocomplete="name" class={input} /></label>
        <label class="contact-field"><span>Work email <span class="text-brand" aria-hidden="true">*</span></span><input name="email" type="email" required autocomplete="email" class={input} /></label>
        <label class="contact-field"><span>Company <span class="text-brand" aria-hidden="true">*</span></span><input name="company" required autocomplete="organization" class={input} /></label>
        <label class="contact-field"><span>Phone <span class="optional">(optional)</span></span><input name="phone" type="tel" autocomplete="tel" class={input} /></label>
      </div>
      <fieldset><legend class="mb-3 text-sm font-medium">Which products interest you? <span class="optional">(optional)</span></legend>
        <div class="grid gap-3 sm:grid-cols-2">
          {PRODUCTS.filter(isAvailable).map((p) => <label class="product-choice"><input type="checkbox" name="products" value={p.fullName} /><span>{p.name}</span></label>)}
        </div>
      </fieldset>
      <label class="contact-field"><span>What would you like to improve? <span class="optional">(optional)</span></span><textarea name="message" rows="4" placeholder="For example: managing stock across two warehouses, tracking batches or reducing manual invoice entry." class={`${input} placeholder:text-ink-500`}></textarea></label>
      <label class="hidden" aria-hidden="true">Leave empty<input name="website" tabindex="-1" autocomplete="off" /></label>
      <button type="submit" class="btn-primary w-full justify-center">Book my demo <span aria-hidden="true">↗</span></button>
      <p data-status role="status" class="text-sm text-ink-500"></p>
      <p class="form-privacy">By submitting, you agree to our <a href="/privacy/">Privacy Policy</a>. You can also <a href={`mailto:${SITE.salesEmail}`}>email our team</a>.</p>
    </form>
  </section>

  <section aria-label="Other ways to reach OrbitPi" class="container-page pb-20">
    <dl class="contact-details">
      <div><dt>General enquiries</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email} ↗</a></dd></div>
      <div><dt>Explore before we talk</dt><dd><a href="/products/">Compare our products ↗</a></dd></div>
      <div><dt>Plan your requirements</dt><dd><a href="/pricing/">What goes into a quote ↗</a></dd></div>
      {SITE.contactDetailsVerified && <div><dt>Office</dt><dd><address class="not-italic">{SITE.legalName}<br />{SITE.address.street}<br />{SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}<br />{SITE.address.country}</address><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a><br /><a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener">Open in Google Maps ↗</a></dd></div>}
    </dl>
  </section>
</BaseLayout>

<style>
  .contact-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr); gap: 72px; padding-block: 56px 72px; align-items: start; }
  .contact-intro .h-display { margin-bottom: 24px; }
  .contact-intro .lead { max-width: 450px; }
  .contact-steps { display: flex; flex-direction: column; gap: 27px; margin-top: 38px; }
  .contact-steps li { display: flex; gap: 18px; }
  .contact-steps li > span { display: grid; place-items: center; flex: none; width: 36px; height: 36px; background: #f2f5ff; border: 1px solid #dfe5fc; border-radius: 9px; color: #435373; font-size: .875rem; }
  .contact-steps h2 { font-size: 16px; font-weight: 600; margin-bottom: 5px; }
  .contact-steps p { font-size: 1rem; line-height: 1.7; color: #5b6170; max-width: 340px; }
  .contact-direct { margin-top: 38px; border-top: 1px solid #e1e6ee; padding-top: 25px; }
  .contact-direct p { color: #5b6170; font-size: 1rem; }
  .contact-direct a { display: inline-flex; gap: 18px; margin-top: 9px; font-size: 20px; font-weight: 550; }
  .contact-direct a:hover { color: #2f4bff; }
  .contact-direct > span { display: block; margin-top: 10px; font-size: .875rem; color: #5b6170; }
  .contact-form { display: flex; flex-direction: column; gap: 24px; padding: 36px; border: 1px solid #dfe5ef; border-radius: 18px; background: #fff; box-shadow: 0 22px 55px -35px #13203944; }
  .form-heading { padding-bottom: 22px; border-bottom: 1px solid #e7ebf0; }
  .form-heading .section-eyebrow { margin-bottom: 10px; }
  .form-heading h2 { font-size: 25px; font-weight: 550; letter-spacing: -.03em; }
  .form-heading > p:last-child { margin-top: 9px; font-size: .875rem; color: #5b6170; }
  .contact-field { display: flex; flex-direction: column; gap: 9px; font-size: 1rem; font-weight: 550; }
  .contact-field input, .contact-field textarea { font-weight: 400; }
  .optional { font-size: .875rem; color: #626d7e; font-weight: 400; }
  .product-choice { display: flex; align-items: center; gap: 10px; padding: 13px 14px; border: 1px solid #dfe5ef; border-radius: 9px; cursor: pointer; font-size: 1rem; }
  .product-choice:has(:checked) { border-color: #2f4bff; background: #f2f5ff; }
  .product-choice:focus-within { outline: 2px solid #2f4bff; outline-offset: 3px; }
  .product-choice input { width: 16px; height: 16px; accent-color: #2f4bff; }
  .form-privacy { font-size: .875rem; line-height: 1.8; color: #626d7e; }
  .form-privacy a { text-decoration: underline; text-underline-offset: 3px; }
  [data-status]:empty { display: none; }
  .contact-details { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; border-top: 1px solid #e1e6ee; padding-top: 32px; }
  .contact-details dt { font-size: .875rem; color: #626d7e; margin-bottom: 10px; }
  .contact-details dd { font-size: 1rem; line-height: 1.8; }
  .contact-details a:hover { color: #2f4bff; }
  @media (max-width: 1023px) { .contact-layout { gap: 36px; } .contact-form { padding: 25px; } }
  @media (max-width: 767px) { .contact-layout { grid-template-columns: 1fr; padding-top: 36px; } .contact-intro .lead { max-width: none; } .contact-steps { gap: 20px; } .contact-details { grid-template-columns: 1fr; } }
  @media (max-width: 399px) { .contact-form { padding: 20px; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-contact]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = 'Thank you. Our team will contact you shortly.';
      } catch {
        status.textContent = 'Something went wrong. Please email us instead.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
