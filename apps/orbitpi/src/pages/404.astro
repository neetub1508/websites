---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PRODUCTS, productHref } from '@/lib/products';
---

<BaseLayout title="Page not found | OrbitPi" description="The page you are looking for does not exist." noindex>
  <section class="container-page flex flex-col items-center gap-6 py-32 text-center">
    <h1 class="h-section">Page not found</h1>
    <p class="lead max-w-md">The page may have moved. Try one of these instead.</p>
    <ul class="flex flex-wrap justify-center gap-2">
      {PRODUCTS.map((p) => <li><a href={productHref(p.slug)} class="block rounded-full border border-line-strong px-4 py-2 text-sm hover:border-ink">{p.fullName}</a></li>)}
    </ul>
    <a href="/" class="btn-dark">Back to home</a>
  </section>
</BaseLayout>
