---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductBadge from '@/components/ProductBadge.astro';
import Faq from '@/components/Faq.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { PRODUCTS, productHref, isAvailable } from '@/lib/products';
import { absoluteUrl } from '@/lib/site';
import { graph, webPage, breadcrumbs, faqPage } from '@/lib/schema';

const title = 'OrbitPi Pricing | AI OCR, Inventory, Lead & Asset Software';
const description = 'OrbitPi is priced per product. Start with one product, add more with suite bundle pricing, or choose Enterprise for multi-branch groups. Get a quote.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Pricing', path: '/pricing/' }];

const plans = [
  { name: 'Single product', text: 'One OrbitPi product for one team.', cta: 'Get a quote', featured: false,
    points: ['Any one available product', 'Runs in your web browser', 'Email support', 'Standard onboarding'] },
  { name: 'Suite', text: 'Two or more products on shared data.', cta: 'Get suite pricing', featured: true,
    points: ['Bundle pricing across products', 'One platform for every product', 'Shared users, branches and roles', 'Guided onboarding'] },
  { name: 'Enterprise', text: 'For multi-branch groups with custom needs.', cta: 'Talk to sales', featured: false,
    points: ['Multiple branches and sites', 'Integrations such as webhooks, S3 and SFTP', 'Custom roles and approvals', 'Dedicated success manager'] },
];

const faqs = [
  { q: 'How is OrbitPi priced?', a: 'OrbitPi is priced per product. You pay only for the products you use, and bundle pricing applies when you use two or more.' },
  { q: 'Can I start with one product and add more later?', a: 'Yes. You can add products at any time on the same platform, with the same users, branches and roles.' },
  { q: 'Is there a free demo?', a: 'Yes. Book a demo and we will run OrbitPi on a sample of your own documents or data.' },
  { q: 'Do you offer pricing for large groups?', a: 'Yes. The Enterprise plan covers multiple branches and sites, integrations and a dedicated success manager.' },
  { q: 'Is Ledger included in the pricing?', a: 'Not yet. OrbitPi Ledger is in development. Pricing covers the four available products: DocAI, Stock, Leads and Assets.' },
];

const schema = graph(webPage(absoluteUrl('/pricing/'), title, description), breadcrumbs(crumbs), faqPage(faqs));
---

<BaseLayout title={title} description={description} schema={schema}>
  <Breadcrumbs items={crumbs} />
  <section class="container-page flex flex-col gap-12 pb-24 pt-12">
    <SectionHeading as="h1" eyebrow="Pricing" title="Pay only for the products you use" lead="Every plan is quoted for your team size and products. Tell us what you need and we’ll send a quote." />
    <ul class="grid gap-4 lg:grid-cols-3">
      {plans.map((pl) => (
        <li class:list={['flex flex-col gap-5 rounded-[20px] border p-8', pl.featured ? 'border-brand bg-brand text-white' : 'border-line-strong bg-white']}>
          <h2 class="text-2xl font-semibold tracking-[-0.03em]">{pl.name}</h2>
          <p class:list={['text-[15px]', pl.featured ? 'text-white' : 'text-ink-500']}>{pl.text}</p>
          <ul class="flex flex-1 flex-col gap-2.5 text-[15px]">
            {pl.points.map((pt) => <li class="flex gap-2.5"><span aria-hidden="true">✓</span>{pt}</li>)}
          </ul>
          <a href="/contact/" class:list={[pl.featured ? 'btn-light' : 'btn-dark', 'self-start']}>{pl.cta}</a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="products-title" class="border-y border-line bg-mist">
    <div class="container-page flex flex-col gap-10 py-24">
      <SectionHeading id="products-title" title="Choose your products" />
      <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
        {PRODUCTS.filter(isAvailable).map((p) => (
          <li><a href={productHref(p.slug)} class="flex h-full flex-col gap-3 rounded-2xl border border-line bg-white p-5 hover:border-ink">
            <ProductBadge product={p} size="lg" /><strong class="font-semibold">{p.fullName}</strong><span class="text-sm text-ink-500">{p.category}</span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <Faq faqs={faqs} title="Pricing FAQ" />
  <CtaBanner title="Get a quote for your team" cta="Talk to sales" />
</BaseLayout>
