---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductBadge from '@/components/ProductBadge.astro';
import ProductCard from '@/components/ProductCard.astro';
import ProductPreview from '@/components/ProductPreview.astro';
import Faq from '@/components/Faq.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { PRODUCTS, productHref, isAvailable, type Product } from '@/lib/products';
import { INDUSTRIES, industryHref } from '@/lib/industries';
import { guidesFor, guideHref } from '@/lib/guides';
import { absoluteUrl } from '@/lib/site';
import { graph, webPage, breadcrumbs, faqPage, softwareApp } from '@/lib/schema';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props { product: Product }
const { product: p } = Astro.props;
const accent = p.theme === 'ledger' ? '#2F4BFF' : p.color;
const path = productHref(p.slug);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Products', path: '/products/' }, { name: p.fullName, path }];
const industries = INDUSTRIES.filter((i) => i.products.includes(p.slug));
const available = isAvailable(p);
const others = PRODUCTS.filter((x) => x.slug !== p.slug && isAvailable(x)).slice(0, 3);
const guides = guidesFor(p.slug);
const image = { src: `/images/og/${p.slug}.jpg`, alt: p.image?.alt ?? p.fullName, width: 1200, height: 630 };

const schema = graph(
  { ...webPage(absoluteUrl(path), p.metaTitle, p.metaDescription), ...(available ? { mainEntity: { '@id': `${absoluteUrl(path)}#software` } } : {}) },
  breadcrumbs(crumbs),
  ...(available ? [softwareApp(p)] : []),
  faqPage(p.faqs),
);
---

<BaseLayout title={p.metaTitle} description={p.metaDescription} schema={schema} image={image}>
  <Breadcrumbs items={crumbs} />

  <section aria-labelledby="page-title" class="container-page grid items-center gap-12 pb-20 pt-10 lg:grid-cols-[1.05fr_1fr]" style={`--accent:${accent}`}>
    <div class="flex flex-col items-start gap-6">
      <p class="flex flex-wrap items-center gap-2.5 text-sm font-medium"><ProductBadge product={p} size="md" />{p.fullName} · {p.category}{!available && <span class="rounded-full bg-[#FFF4E0] px-2.5 py-0.5 text-xs font-medium text-[#9A5B00]">Coming soon</span>}</p>
      <h1 id="page-title" class="text-[clamp(38px,5vw,60px)] font-bold leading-[1.04] tracking-tightest">{p.h1}</h1>
      <p class="lead">{p.intro}</p>
      <div class="flex flex-wrap gap-3">
        <a href="/contact/" class="btn-primary">{available ? 'Book a demo' : 'Ask for early access'}</a>
        <a href="#features" class="btn-ghost">{available ? 'See features' : 'See planned features'}</a>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-ink-500">
        {p.highlights.map((h) => <li class="flex gap-1.5"><span aria-hidden="true" class="text-[var(--accent)]">✓</span>{h}</li>)}
      </ul>
    </div>
    <ProductPreview product={p} />
  </section>

  <section id="features" aria-labelledby="features-title" class="border-y border-line bg-mist">
    <div class="container-page flex flex-col gap-12 py-24">
      <SectionHeading id="features-title" title={`${p.fullName} features`} lead={available ? `What ${p.fullName} does today, feature by feature.` : `What we are building into ${p.fullName}. None of this is available yet.`} />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {p.features.map((f) => (
          <li class="flex flex-col gap-2.5 rounded-2xl border border-line bg-white p-6">
            <h3 class="text-base font-semibold tracking-[-0.01em]">{f.title}</h3>
            <p class="text-[14.5px] leading-relaxed text-ink-500">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="how-title" class="container-page flex flex-col gap-12 py-24">
    <SectionHeading id="how-title" title={available ? `How ${p.fullName} works` : `Planned ${p.fullName} workflow`} />
    {p.image && (
      <figure class="overflow-hidden rounded-[20px] border border-line bg-[#FCFAF4]">
        <img src={p.image.src} srcset={`${p.image.srcSmall} 640w, ${p.image.src} ${p.image.width}w`} sizes="(min-width:1048px) 1000px, calc(100vw - 50px)" alt={p.image.alt} width={p.image.width} height={p.image.height} loading="lazy" decoding="async" class="mx-auto h-auto w-full max-w-[1000px]" />
      </figure>
    )}
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {p.steps.map((s, i) => (
        <li class="flex flex-col gap-3 rounded-2xl border border-line p-6">
          <span class="grid size-8 place-items-center rounded-full text-sm font-semibold" style={`background:${p.soft};color:${accent}`}>{i + 1}</span>
          <h3 class="text-lg font-semibold tracking-[-0.02em]">{s.title}</h3>
          <p class="text-[15px] leading-normal text-ink-500">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="uses-title" class="bg-ink text-white">
    <div class="container-page flex flex-col gap-12 py-24">
      <SectionHeading id="uses-title" title={`Who ${p.fullName} is for`} inverted />
      <ul class="grid gap-4 md:grid-cols-3">
        {p.useCases.map((u) => (
          <li class="flex flex-col gap-2.5 rounded-2xl border border-[#252935] bg-[#15181F] p-6">
            <h3 class="text-lg font-semibold">{u.title}</h3>
            <p class="text-[15px] leading-relaxed text-[#B9BDC9]">{u.body}</p>
          </li>
        ))}
      </ul>
      {industries.length > 0 && (
        <p class="text-center text-[15px] text-[#B9BDC9]">
          Relevant industries:{' '}
          {industries.map((ind, i) => (<><a href={industryHref(ind.slug)} class="font-medium text-white underline-offset-4 hover:underline">{ind.name}</a>{i < industries.length - 1 && ', '}</>))}
        </p>
      )}
    </div>
  </section>

  {p.upcoming && (
    <section aria-labelledby="upcoming-title" class="container-page pt-24">
      <div class="flex flex-col gap-3 rounded-[20px] border border-[#F5D9A8] bg-[#FFF9EE] p-[clamp(24px,4vw,40px)]">
        <p class="text-xs font-semibold uppercase tracking-wider text-[#9A5B00]">Coming soon</p>
        <h2 id="upcoming-title" class="text-2xl font-semibold tracking-[-0.03em]">{p.upcoming.title}</h2>
        <p class="max-w-3xl text-[16px] leading-relaxed text-ink-700">{p.upcoming.body}</p>
        {p.theme === 'leads' && (
          <img src="/images/features/voice-ai-coming-soon.webp" srcset="/images/features/voice-ai-coming-soon-640.webp 640w, /images/features/voice-ai-coming-soon.webp 1200w" sizes="(min-width:578px) 480px, calc(100vw - 98px)" alt="Concept illustration of a voice waveform, phone and contact cards; the AI voice agent is coming soon." width="1200" height="900" loading="lazy" decoding="async" class="mt-3 block aspect-[4/3] h-auto w-full max-w-[480px] rounded-2xl bg-[#FCFAF4] object-contain" />
        )}
      </div>
    </section>
  )}

  {p.integrations.length > 0 && (
    <section aria-labelledby="works-title" class="container-page flex flex-col gap-10 py-24">
      <SectionHeading id="works-title" title={`What ${p.fullName} works with`} lead="Get data in and out with the tools you already use." />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {p.integrations.map((it) => (
          <li class="flex flex-col gap-2 rounded-2xl border border-line p-6">
            <h3 class="text-base font-semibold">{it.title}</h3>
            <p class="text-[14.5px] leading-relaxed text-ink-500">{it.body}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
  {p.integrations.length === 0 && <div class="pb-24"></div>}

  <section aria-labelledby="evaluation-title" class="container-page flex flex-col gap-10 pb-24">
    <SectionHeading id="evaluation-title" title={available ? `What to check in your ${p.fullName} demo` : 'Discuss your accounting software requirements'} lead={available ? 'Use a representative sample of your work to check fit, setup and outputs before choosing a product.' : 'Share your requirements while Ledger is in development. Availability and scope will be confirmed before launch.'} />
    <ul class="grid gap-4 md:grid-cols-3">
      {p.evaluation.map((item) => (
        <li class="flex flex-col gap-2.5 rounded-2xl border border-line p-6">
          <h3 class="text-lg font-semibold">{item.title}</h3>
          <p class="text-[15px] leading-relaxed text-ink-500">{item.body}</p>
        </li>
      ))}
    </ul>
    <p class="text-[15px] text-ink-500">{available ? 'Compare single-product and suite options on our ' : 'See the available products on our '}<a href="/pricing/" class="font-medium text-brand hover:underline">software pricing page</a>, or <a href="/contact/" class="font-medium text-brand hover:underline">talk to the OrbitPi product team</a> about your requirements.</p>
  </section>

  {guides.length > 0 && (
    <section aria-labelledby="guides-title" class="container-page flex flex-col gap-6 pb-24">
      <h2 id="guides-title" class="text-2xl font-semibold tracking-[-0.02em]">Guides for {p.category.toLowerCase()} teams</h2>
      <ul class="grid gap-4 md:grid-cols-2">
        {guides.map((g) => (
          <li><a href={guideHref(g.slug)} class="flex h-full flex-col gap-2 rounded-2xl border border-line p-6 hover:border-ink">
            <span class="text-[13px] text-ink-500">{g.topic}</span>
            <span class="text-lg font-semibold leading-snug">{g.title}</span>
            <span class="text-[14.5px] leading-relaxed text-ink-500">{g.metaDescription}</span>
          </a></li>
        ))}
      </ul>
    </section>
  )}

  <div class="border-t border-line bg-mist"><Faq faqs={p.faqs} title={`${p.fullName} FAQ`} /></div>

  <section aria-labelledby="more-title" class="container-page flex flex-col gap-10 py-24">
    <SectionHeading id="more-title" title="Explore more OrbitPi products" />
    <div class="grid gap-4 md:grid-cols-3">
      {others.map((o) => <ProductCard product={o} />)}
    </div>
  </section>

  {available
    ? <CtaBanner title={`See ${p.fullName} on your own data`} />
    : <CtaBanner title={`Get early access to ${p.fullName}`} text="Tell us how your finance team works today and we will keep you updated as Ledger is built." cta="Contact us" />}
</BaseLayout>
