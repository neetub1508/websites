---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductBadge from '@/components/ProductBadge.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { PRODUCTS, productHref, isAvailable } from '@/lib/products';
import { INDUSTRIES, industryHref } from '@/lib/industries';
import { SITE, absoluteUrl } from '@/lib/site';
import { graph, webPage, breadcrumbs } from '@/lib/schema';

const title = 'About OrbitPi | Business Software Product Company';
const description = 'Meet OrbitPi, a software product company building document OCR, warehouse inventory, lead management and asset management tools for Indian businesses.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }];
const schema = graph(webPage(absoluteUrl('/about/'), title, description, 'AboutPage'), breadcrumbs(crumbs));

const principles = [
  { title: 'Focused products, one platform', body: 'Each OrbitPi product does one job well. They all run on the same platform, with the same users, branches and roles, so adding a second product is simple.' },
  { title: 'AI that people can check', body: 'Our AI shows its work. DocAI scores every value with checks such as arithmetic and QR matching, and sends doubtful values to a person instead of guessing.' },
  { title: 'Indian rules built in', body: 'GSTINs, HSN codes, e-way bills, delivery challans, e-invoice QR codes, CARO verification and rupee valuation are part of the products, not add-ons.' },
  { title: 'Controls finance teams trust', body: 'Maker-checker approvals, branch-level access and audit trails of every change are standard, because back-office data has to stand up to an audit.' },
  { title: 'Honest about what is ready', body: 'We label planned work as coming soon. If a feature is on this website without that label, you can use it today.' },
  { title: 'Proven on your own data', body: 'Every demo runs on a sample of your own documents, stock or leads, so you see how OrbitPi handles your real work before you decide.' },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <Breadcrumbs items={crumbs} />
  <section class="container-page flex flex-col gap-8 pb-20 pt-12">
    <SectionHeading as="h1" title="A software product company built around business operations" align="left" />
    <div class="grid gap-8 text-[17px] leading-relaxed text-ink-700 md:grid-cols-2">
      <p>OrbitPi is a software product company. We develop DocAI for document OCR, Stock for warehouse inventory, Leads for sales enquiries and Assets for fixed asset management. Each product addresses a specific operational workflow and can be used on its own.</p>
      <p>We build for Indian businesses, from distributors and manufacturers to multi-branch teams. Our browser-based products share users, branches and roles, with tools for Indian business workflows such as GST documents and asset verification. Accounting software and the AI voice agent are in development.</p>
    </div>
    <img src="/images/platform/connected-platform.webp" srcset="/images/platform/connected-platform-720.webp 720w, /images/platform/connected-platform.webp 1440w" sizes="(min-width:948px) 900px, calc(100vw - 48px)" alt="Document processing, stock, lead and asset tools connected through one shared platform." width="1440" height="960" loading="eager" fetchpriority="high" decoding="async" class="mx-auto block max-w-[900px] aspect-[3/2] h-auto w-full rounded-[20px] border border-line bg-[#FCFAF4] object-contain" />
  </section>

  <section aria-labelledby="build-title" class="border-y border-line bg-mist">
    <div class="container-page flex flex-col gap-10 py-24">
      <SectionHeading id="build-title" title="OrbitPi products" />
      <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-5">
        {PRODUCTS.map((p) => (
          <li>
            <a href={productHref(p.slug)} class="flex h-full flex-col gap-3 rounded-2xl border border-line bg-white p-5 hover:border-ink">
              <ProductBadge product={p} size="lg" />
              <strong class="font-semibold">{p.fullName}</strong>
              <span class="text-sm text-ink-500">{p.summary}</span>
              {!isAvailable(p) && <span class="self-start rounded-full bg-[#FFF4E0] px-2 py-px text-[11px] font-medium text-[#9A5B00]">Coming soon</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="principles-title" class="container-page flex flex-col gap-12 py-24">
    <SectionHeading id="principles-title" title="How we build OrbitPi" />
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {principles.map((p) => (
        <li class="flex flex-col gap-2.5 rounded-2xl border border-line p-6">
          <h3 class="text-lg font-semibold">{p.title}</h3>
          <p class="text-[15px] leading-relaxed text-ink-500">{p.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="who-title" class="border-t border-line bg-mist">
    <div class="container-page flex flex-col gap-8 py-24">
      <SectionHeading id="who-title" title="Industries we work with" align="left" lead="OrbitPi is designed for businesses that need to track stock, documents, sales enquiries and equipment across teams and locations." />
      <ul class="flex flex-wrap gap-2">
        {INDUSTRIES.map((i) => <li><a href={industryHref(i.slug)} class="block rounded-full border border-line-strong bg-white px-4 py-2 text-sm hover:border-ink">{i.name}</a></li>)}
      </ul>
      <dl class="grid gap-6 border-t border-line pt-8 text-[15px] sm:grid-cols-3">
        <div class="flex flex-col gap-1"><dt class="text-[13px] font-semibold">Company</dt><dd class="text-ink-500">{SITE.legalName}</dd></div>
        {SITE.contactDetailsVerified && <div class="flex flex-col gap-1"><dt class="text-[13px] font-semibold">Location</dt><dd class="text-ink-500">{SITE.address.city}, {SITE.address.region}, {SITE.address.country}</dd></div>}
        <div class="flex flex-col gap-1"><dt class="text-[13px] font-semibold">Contact</dt><dd><a href={`mailto:${SITE.email}`} class="text-ink-500 hover:text-brand">{SITE.email}</a></dd></div>
      </dl>
    </div>
  </section>

  <div class="pt-24"><CtaBanner title="Talk to the OrbitPi team" cta="Contact us" /></div>
</BaseLayout>
