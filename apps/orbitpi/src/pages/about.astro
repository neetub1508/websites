---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { SITE, absoluteUrl } from '@/lib/site';
import { graph, webPage, breadcrumbs } from '@/lib/schema';

const title = 'About OrbitPi | AI Business Software from Gurugram, India';
const description = `OrbitPi builds AI software for the back office: document OCR, inventory, leads, assets and accounting. Headquartered in ${SITE.address.city}, India.`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }];
const schema = graph(webPage(absoluteUrl('/about/'), title, description, 'AboutPage'), breadcrumbs(crumbs));

const principles = [
  { title: 'One record, many products', body: 'Every OrbitPi product shares the same customers, items and accounts, so data is entered once.' },
  { title: 'AI that people can check', body: 'Our AI shows its work. Reviewers see the source and confidence behind every extracted value and every call outcome.' },
  { title: 'Built for real operations', body: 'Warehouses, finance teams and sales floors use OrbitPi daily, on web and mobile.' },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <Breadcrumbs items={crumbs} />
  <section class="container-page flex flex-col gap-8 pb-20 pt-12">
    <SectionHeading as="h1" eyebrow="About OrbitPi" title="We build AI that runs the back office" align="left" />
    <div class="grid gap-8 text-[17px] leading-relaxed text-ink-700 md:grid-cols-2">
      <p>OrbitPi makes five AI products for the work that keeps a business running: reading documents, managing stock, following up leads, tracking assets and keeping the books.</p>
      <p>We are headquartered in {SITE.address.city}, {SITE.address.region}, and build for businesses in India and around the world, from growing SMBs to multi-company groups.</p>
    </div>
  </section>

  <section aria-labelledby="principles-title" class="border-y border-line bg-mist">
    <div class="container-page flex flex-col gap-12 py-24">
      <SectionHeading id="principles-title" eyebrow="What we believe" title="How we build OrbitPi" />
      <ul class="grid gap-4 md:grid-cols-3">
        {principles.map((p) => (
          <li class="flex flex-col gap-2.5 rounded-2xl border border-line bg-white p-6">
            <h3 class="text-lg font-semibold">{p.title}</h3>
            <p class="text-[15px] leading-relaxed text-ink-500">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="pt-24"><CtaBanner title="Talk to the OrbitPi team" cta="Contact us" /></div>
</BaseLayout>
