---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductBadge from '@/components/ProductBadge.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { GUIDES, guideHref } from '@/lib/guides';
import { getProduct, type Product } from '@/lib/products';
import { absoluteUrl } from '@/lib/site';
import { graph, webPage, breadcrumbs, itemList } from '@/lib/schema';

const title = 'Guides: Inventory, Fixed Assets, Sales and GST | OrbitPi';
const description = 'Practical guides on inventory valuation, depreciation, lead routing and, for Indian businesses, e-way bills, GST e-invoices and CARO asset verification.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Guides', path: '/guides/' }];
const topics = [...new Set(GUIDES.map((g) => g.topic))];
const schema = graph(
  webPage(absoluteUrl('/guides/'), title, description, 'CollectionPage'),
  breadcrumbs(crumbs),
  itemList('OrbitPi guides', GUIDES.map((g) => ({ name: g.title, path: guideHref(g.slug) }))),
);
---

<BaseLayout title={title} description={description} schema={schema}>
  <Breadcrumbs items={crumbs} />
  <section class="container-page flex flex-col gap-14 pb-24 pt-12">
    <SectionHeading as="h1" title="Guides to inventory, fixed assets, sales and GST" align="left" lead="Plain-language explainers on the back-office rules and workflows operations teams deal with every day, with worked examples and links to official sources. Guides marked India cover Indian tax and audit rules." />
    {topics.map((topic) => (
      <section aria-labelledby={`topic-${topic.toLowerCase().replace(/\W+/g, '-')}`} class="flex flex-col gap-5">
        <h2 id={`topic-${topic.toLowerCase().replace(/\W+/g, '-')}`} class="text-2xl font-semibold tracking-[-0.02em]">{topic}</h2>
        <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {GUIDES.filter((g) => g.topic === topic).map((g) => {
            const p = getProduct(g.product) as Product;
            return (
              <li>
                <a href={guideHref(g.slug)} class="group flex h-full flex-col gap-3 rounded-2xl border border-line bg-white p-6 transition hover:shadow-card">
                  <span class="flex items-center gap-2 text-[13px] text-ink-500"><ProductBadge product={p} size="sm" />Related: {p.fullName}{g.region && <span class="rounded-full border border-line-strong px-2 py-px text-[11px] font-medium text-ink-700">{g.region}</span>}</span>
                  <h3 class="text-lg font-semibold leading-snug">{g.title}</h3>
                  <p class="text-[14.5px] leading-relaxed text-ink-500">{g.metaDescription}</p>
                  <span class="mt-auto text-sm font-medium text-brand">Read the guide <span aria-hidden="true" class="inline-block transition group-hover:translate-x-0.5">→</span></span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </section>
  <CtaBanner />
</BaseLayout>
