{
  // Cloudflare Workers config — serves the Astro static build (dist/) as
  // static assets. The Worker enforces the production HTTPS origin before
  // passing through to assets, and handles POST /api/contact.
  "name": "orbitpi",
  "compatibility_date": "2026-09-27",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
